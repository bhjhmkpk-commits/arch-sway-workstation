# ==============================================================================
# 🚀 bohar Workstation - Sway Window Manager Configuration
# Synced with Omarchy keybindings & optimized for Intel Core i5-6400 + HD 530
# ==============================================================================

set $mod Mod4
set $term foot
set $menu wofi --show drun

# Typography
font pango:JetBrainsMono Nerd Font 12

# Hardware & Display
output * bg #23382f solid_color
output HDMI-A-1 mode 1920x1080@60Hz

# Gaps & Borders
default_border pixel 2
default_floating_border pixel 2
gaps inner 6
gaps outer 4
focus_on_window_activation focus

# Colors (Everforest / Forest Sage - Eye Care)
client.focused          #a7c080 #23382f #e6e2d8 #a7c080 #a7c080
client.focused_inactive #36453b #23382f #9aa59a #36453b #36453b
client.unfocused        #2a362f #1e2a24 #889488 #2a362f #2a362f
client.urgent           #e67e80 #23382f #e67e80 #e67e80 #e67e80

# ── 1. Core Actions & Launchers (Omarchy Parity) ──────────────────────────────
bindsym $mod+Return exec $term
bindsym $mod+Mod1+Return exec $term --app-id=tmux -e tmux new -A -s Work
bindsym $mod+w kill
bindsym $mod+t floating toggle
bindsym Mod1+Tab focus right
bindsym Mod1+Shift+Tab focus left
bindsym $mod+Ctrl+l exec swaylock
bindsym $mod+d exec $menu
bindsym $mod+space exec $menu
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space focus mode_toggle
bindsym $mod+k exec ~/.local/bin/cheatsheet-menu
bindsym $mod+slash exec ~/.local/bin/keysheet-menu
bindsym $mod+question exec ~/.local/bin/keysheet-menu
bindsym $mod+F1 exec ~/.local/bin/keysheet-menu
bindsym $mod+Shift+v exec ~/.local/bin/cliphist-menu
bindsym $mod+c exec ~/.local/bin/universal-copy
bindsym $mod+v exec ~/.local/bin/universal-paste
bindsym $mod+Ctrl+c exec ~/.local/bin/clip-push
bindsym $mod+Escape exec $term --app-id=btop -e btop
bindsym $mod+Shift+r reload
bindsym $mod+Backspace exec swaylock
bindsym $mod+Shift+e exec swaynag -t warning -m "Power Menu" -B "Power Off" "systemctl poweroff -i" -B "Reboot" "systemctl reboot -i" -B "Exit Sway" "swaymsg exit"

# ── 2. Applications & Workstation Utilities ────────────────────────────────────
# Web Browsers
bindsym $mod+b exec chromium
bindsym $mod+Shift+b exec ~/.local/bin/brave-origin

# File Managers
bindsym $mod+Shift+f exec thunar
bindsym $mod+Mod1+f exec $term --app-id=yazi -e yazi

# Academic & Documents
bindsym $mod+p exec xournalpp
bindsym $mod+Shift+p exec pdfarranger
bindsym $mod+equal exec galculator
bindsym $mod+Shift+c exec galculator
bindsym $mod+i exec pinta
bindsym $mod+m exec mousepad

# USB & Storage Utilities
bindsym $mod+u exec gnome-disks
bindsym $mod+Shift+u exec ventoygui
bindsym $mod+Ctrl+d exec $term --app-id=gdu -e gdu ~

# Android & Mobile Utilities
bindsym $mod+a exec scrcpy
bindsym $mod+Mod1+a exec uad-ng
bindsym $mod+Ctrl+m exec ~/.local/bin/phone-mount
bindsym $mod+Ctrl+Shift+m exec ~/.local/bin/phone-mount -u
bindsym $mod+Ctrl+p exec $term --app-id=phone-clip -e ~/.local/bin/phone-clip
bindsym $mod+Mod1+l exec localsend

# Developer Tools
bindsym $mod+g exec $term --app-id=lazygit -e lazygit

# Web Apps & AI Tools
bindsym $mod+Shift+a exec ~/.local/bin/webapp gui
bindsym $mod+Mod1+g exec chromium --app="https://gemini.google.com/" --name="webapp-gemini" --class="WebApp-gemini"
bindsym $mod+Mod1+c exec chromium --app="https://chatgpt.com" --name="webapp-chatgpt" --class="WebApp-chatgpt"
bindsym $mod+Mod1+k exec chromium --app="https://claude.ai" --name="webapp-claude-ai" --class="WebApp-claude-ai"
bindsym $mod+Mod1+d exec chromium --app="https://claude.ai" --name="webapp-claude-ai" --class="WebApp-claude-ai"
bindsym $mod+Mod1+w exec chromium --app="https://web.whatsapp.com" --name="webapp-whatsapp-web" --class="WebApp-whatsapp-web"
bindsym $mod+Mod1+m exec chromium --app="https://mail.google.com" --name="webapp-gmail" --class="WebApp-gmail"
bindsym $mod+Shift+y exec chromium --app="https://youtube.com" --name="webapp-youtube" --class="WebApp-youtube"
bindsym $mod+Shift+m exec chromium --app="https://music.youtube.com" --name="webapp-youtube-music" --class="WebApp-youtube-music"
bindsym $mod+y exec $term --app-id=yt-dlp-menu -e yt-dlp-menu

# ── 3. Audio & Media Routing (playerctl & pamixer) ─────────────────────────────
bindsym $mod+Mod1+p exec playerctl play-pause
bindsym $mod+bracketright exec playerctl next
bindsym $mod+bracketleft exec playerctl previous
bindsym $mod+n exec ~/.local/bin/nightlight toggle
bindsym $mod+Shift+n exec ~/.local/bin/nightlight cycle
bindsym $mod+Mod1+e exec ~/.local/bin/sway-wellbeing menu
bindsym $mod+Ctrl+e exec ~/.local/bin/sway-wellbeing toggle

bindsym XF86AudioRaiseVolume exec pamixer -i 5
bindsym XF86AudioLowerVolume exec pamixer -d 5
bindsym XF86AudioMute exec pamixer -t
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# ── 4. Screen Brightness ──────────────────────────────────────────────────────
bindsym XF86MonBrightnessUp exec ~/.local/bin/brightness-ctrl inc
bindsym XF86MonBrightnessDown exec ~/.local/bin/brightness-ctrl dec

# ── 5. Screenshots & OCR (Grim & Slurp & Satty & Tesseract) ─────────────────
bindsym Print exec ~/.local/bin/screenshot full
bindsym Shift+Print exec ~/.local/bin/screenshot area
bindsym Mod1+Print exec ~/.local/bin/ocr-grab
bindsym $mod+Shift+o exec ~/.local/bin/ocr-grab

# ── 6. Window Navigation (Vim & Arrows) ────────────────────────────────────────
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# ── 7. Layout Splits ──────────────────────────────────────────────────────────
bindsym $mod+minus splitv
bindsym $mod+backslash splith
bindsym $mod+s layout stacking
bindsym $mod+Shift+w layout tabbed
bindsym $mod+e layout toggle split

# ── 8. Workspaces (1 - 10) ───────────────────────────────────────────────────
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# ── 9. Status Bar & Autostart Daemons ─────────────────────────────────────────
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP=sway SWAYSOCK
exec_always /home/bohar/.local/bin/waybar-run
exec_always mako
exec lxpolkit
exec /usr/lib/xdg-desktop-portal-wlr
exec ~/.local/bin/nightlight on
exec_always xhost +si:localuser:root >/dev/null 2>&1

# Idle inhibitor: Prevent screen sleep when any window is fullscreen
for_window [all] inhibit_idle fullscreen

# Floating dialogs and utility popups
for_window [app_id="floating-terminal"] floating enable, resize set 750 480
for_window [app_id="pavucontrol"] floating enable, resize set 800 500
for_window [app_id="viewnior"] floating enable
for_window [app_id="xarchiver"] floating enable
for_window [app_id=".*satty.*"] floating enable
for_window [app_id="phone-clip"] floating enable, resize set 750 560
for_window [app_id="zenity"] floating enable
for_window [class="Ventoy2Disk.gtk3"] floating enable
for_window [app_id="yt-dlp-menu"] floating enable, resize set 880 620
for_window [app_id="yazi-floating"] floating enable, resize set 1100 700
