{
    "layer": "top",
    "position": "top",
    "height": 36,
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/window"
    ],
    "modules-center": [
        "clock",
        "custom/wellbeing"
    ],
    "modules-right": [
        "pulseaudio",
        "custom/brightness",
        "custom/nightlight",
        "network",
        "cpu",
        "memory",
        "battery"
    ],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },
    "sway/window": {
        "format": "{app_id} : {title}",
        "max-length": 34,
        "separate-outputs": true,
        "icon": true,
        "icon-size": 18,
        "icon-spacing": 8,
        "rewrite": {
            "^ : $": "",
            "^$": "",
            "^foot : .*": "Terminal",
            "^floating-terminal : .*": "Terminal",
            "^tmux : .*": "Tmux",
            "^(?:chrome|brave)-music\\.youtube\\.com.* : (.*) \\| YouTube Music": "$1",
            "^(?:chrome|brave)-music\\.youtube\\.com.* : YouTube Music": "YouTube Music",
            "^(?:chrome|brave)-music\\.youtube\\.com.*": "YouTube Music",
            "^(?:chrome|brave)-youtube\\.com.* : (.*) - YouTube": "$1",
            "^(?:chrome|brave)-youtube\\.com.* : (.*)": "YouTube: $1",
            "^(?:chrome|brave)-youtube\\.com.*": "YouTube",
            "^(?:chrome|brave)-chatgpt\\.com.* : (.*) - ChatGPT": "$1",
            "^(?:chrome|brave)-chatgpt\\.com.*": "ChatGPT",
            "^(?:chrome|brave)-claude\\.ai.* : (.*)": "$1",
            "^(?:chrome|brave)-claude\\.ai.*": "Claude AI",
            "^(?:chrome|brave)-gemini\\.google\\.com.* : (.*)": "$1",
            "^(?:chrome|brave)-gemini\\.google\\.com.*": "Gemini",
            "^(?:chrome|brave)-github\\.com.* : (.*) · GitHub": "$1",
            "^(?:chrome|brave)-github\\.com.* : (.*)": "$1",
            "^(?:chrome|brave)-github\\.com.*": "GitHub",
            "^(?:chrome|brave)-web\\.whatsapp\\.com.* : (.*)": "WhatsApp: $1",
            "^(?:chrome|brave)-web\\.whatsapp\\.com.*": "WhatsApp",
            "^(?:chrome|brave)-mail\\.google\\.com.* : (.*) - Gmail": "$1",
            "^(?:chrome|brave)-mail\\.google\\.com.*": "Gmail",
            "^(?:chrome|brave)-calendar\\.google\\.com.*": "Calendar",
            "^(?:chrome|brave)-reddit\\.com.* : (.*) - Reddit": "$1",
            "^(?:chrome|brave)-reddit\\.com.*": "Reddit",
            "^(?:chrome|brave)-([a-zA-Z0-9-]+)\\..* : (.*)": "$2",
            "^chromium : (.*) - Chromium": "$1",
            "^chromium : (.*)": "$1",
            "^chromium$": "Chromium",
            "^brave.* : (.*) - Brave.*": "$1",
            "^brave.* : (.*)": "$1",
            "^brave.*": "Brave Browser",
            "^thunar : (.*) - File Manager": "Files: $1",
            "^thunar : (.*)": "$1",
            "^thunar$": "Files",
            "^yazi : (.*)": "Yazi: $1",
            "^yazi$": "Yazi",
            "^xarchiver : (.*)": "Archive: $1",
            "^xarchiver$": "Archive Manager",
            "^xreader : (.*) - Document Viewer": "Docs: $1",
            "^xreader : (.*)": "$1",
            "^xreader$": "Documents",
            "^mpv : (.*)": "$1",
            "^mpv$": "Video Player",
            "^viewnior : (.*) - Viewnior": "$1",
            "^viewnior : (.*)": "$1",
            "^viewnior$": "Image Viewer",
            ".* : nvim (.*)": "Neovim: $1",
            ".* : nvim$": "Neovim",
            "^gedit : (.*)": "Editor: $1",
            "^mousepad : (.*)": "Editor: $1",
            "^code.* : (.*) - Visual Studio Code": "$1",
            "^code.*": "VS Code",
            ".* : btop$": "System Monitor",
            "^btop$": "System Monitor",
            ".*pavucontrol.*": "Audio Settings",
            ".*satty.*": "Screenshot Editor",
            "^wofi.*": "Application Menu",
            "^[a-zA-Z0-9._-]+ : (.+)": "$1",
            "^([a-zA-Z0-9._-]+) : ?$": "$1"
        }
    },
    "cpu": {
        "format": "\udb83\udee0 {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "\udb80\udf5b {used:0.1f}G/{total:0.1f}G",
        "interval": 2
    },
    "network": {
        "format-wifi": "\udb82\udd28 {essid}",
        "format-ethernet": "\udb80\ude00 Ethernet",
        "format-linked": "\udb80\ude00 Ethernet (No IP)",
        "format-disconnected": "\udb82\udd2e Offline",
        "tooltip-format-wifi": "\udb82\udd28 Wi-Fi: {essid} ({signalStrength}%)\nIP: {ipaddr}\nInterface: {ifname}\nClick to manage connections",
        "tooltip-format-ethernet": "\udb80\ude00 Wired: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}\nClick to manage connections",
        "tooltip-format-disconnected": "\udb82\udd2e Disconnected\nClick to connect to Wi-Fi",
        "interval": 3,
        "on-click": "foot --app-id=floating-terminal -e nmtui"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\udb81\udf5f Muted",
        "format-icons": {
            "default": [
                "\udb81\udd7f",
                "\udb81\udd80",
                "\udb81\udd7e"
            ]
        },
        "scroll-step": 5,
        "on-click": "pamixer -t",
        "on-click-right": "pavucontrol"
    },
    "custom/wellbeing": {
        "format": "{}",
        "return-type": "json",
        "exec": "cat /run/user/1000/wellbeing-waybar.json 2>/dev/null || ~/.local/bin/sway-wellbeing line",
        "interval": 1,
        "on-click": "~/.local/bin/sway-wellbeing toggle",
        "on-click-right": "~/.local/bin/sway-wellbeing menu",
        "on-click-middle": "~/.local/bin/sway-wellbeing skip",
        "tooltip": true
    },
    "custom/brightness": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.local/bin/brightness-ctrl status",
        "interval": 3600,
        "signal": 9,
        "on-click": "~/.local/bin/brightness-ctrl cycle",
        "on-click-right": "~/.local/bin/brightness-ctrl toggle",
        "on-scroll-up": "~/.local/bin/brightness-ctrl inc",
        "on-scroll-down": "~/.local/bin/brightness-ctrl dec",
        "smooth-scrolling-threshold": 1.0,
        "tooltip": true
    },
    "custom/nightlight": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.local/bin/nightlight status",
        "interval": 3600,
        "signal": 8,
        "on-click": "~/.local/bin/nightlight toggle",
        "on-click-right": "~/.local/bin/nightlight cycle",
        "on-scroll-up": "~/.local/bin/nightlight inc",
        "on-scroll-down": "~/.local/bin/nightlight dec",
        "smooth-scrolling-threshold": 1.0,
        "tooltip": true
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "clock": {
        "format": "\udb80\udced {:%Y-%m-%d  \udb82\udd54 %I:%M %p}",
        "interval": 60
    }
}