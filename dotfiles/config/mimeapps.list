[Default Applications]
text/html=chromium.desktop
x-scheme-handler/http=chromium.desktop
x-scheme-handler/https=chromium.desktop
x-scheme-handler/about=chromium.desktop
x-scheme-handler/unknown=chromium.desktop

# Images -> Viewnior (Crop, Rotate, Fast Viewer)
image/jpeg=viewnior.desktop
image/png=viewnior.desktop
image/gif=viewnior.desktop
image/webp=viewnior.desktop
image/bmp=viewnior.desktop
image/tiff=viewnior.desktop
image/svg+xml=viewnior.desktop

# Video -> MPV (Hardware Accelerated, Audio Track Switcher)
video/mp4=mpv.desktop
video/mkv=mpv.desktop
video/x-matroska=mpv.desktop
video/webm=mpv.desktop
video/x-msvideo=mpv.desktop
video/quicktime=mpv.desktop
video/mpeg=mpv.desktop
audio/mpeg=mpv.desktop
audio/flac=mpv.desktop
audio/ogg=mpv.desktop

# Documents & PDF -> Xreader (Multi-Tabbed Document Viewer)
application/pdf=xreader.desktop
application/postscript=xreader.desktop
application/x-dvi=xreader.desktop
application/epub+zip=xreader.desktop
