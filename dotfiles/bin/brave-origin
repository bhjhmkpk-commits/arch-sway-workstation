#!/usr/bin/env bash
# ==============================================================================
# 🦁 Brave Browser Launcher Wrapper (Wayland & Hardware Accelerated)
# ==============================================================================

# Search for any installed flavor of Brave (Origin, Nightly, Beta, Stable)
for bin in /usr/bin/brave-origin /usr/bin/brave-origin-nightly /usr/bin/brave-origin-beta /usr/bin/brave-browser /usr/bin/brave /usr/bin/brave-nightly /usr/bin/brave-beta; do
    if [ -x "$bin" ]; then
        exec "$bin" \
            --ozone-platform-hint=auto \
            --force-dark-mode \
            --enable-features=VaapiVideoDecodeLinuxGL,VaapiIgnoreDriverChecks \
            --enable-gpu-rasterization \
            --enable-zero-copy \
            "$@"
    fi
done

# If none installed, notify the user
notify-send -u normal -i dialog-information "Brave Browser" "Brave is not installed yet.\nRun 'yay -S brave-origin-bin' in your terminal."
