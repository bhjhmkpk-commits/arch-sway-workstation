#!/usr/bin/env bash
# ==============================================================================
# Waybar Launch & Reload Wrapper for Sway
# Ensures clean single-instance execution across boots and Sway config reloads
# ==============================================================================

# Terminate existing waybar instances if running
pkill -x waybar 2>/dev/null
while pgrep -x waybar >/dev/null 2>&1; do
    sleep 0.05
done

# Launch waybar
exec /usr/bin/waybar
