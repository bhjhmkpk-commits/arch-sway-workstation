#!/usr/bin/env bash
# ==============================================================================
# 🌐 Arch Sway Workstation - Web App Maker & Manager
# Creates clean, standalone, bar-less PWAs using Chromium --app mode
# ==============================================================================

set -e

APPS_DIR="$HOME/.local/share/applications"
ICONS_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"

mkdir -p "$APPS_DIR" "$ICONS_DIR"

safe_name() {
    printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_-]+/-/g; s/^-+|-+$//g'
}

normalize_url() {
    local url="$1"
    if [[ ! "$url" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*:// ]]; then
        url="https://$url"
    fi
    printf '%s' "$url"
}

fetch_icon() {
    local url="$1"
    local dest="$2"
    local domain
    domain=$(printf '%s' "$url" | sed -E 's|https?://([^/]+).*|\1|')

    # Try high-res Apple Touch Icon first
    local page
    page=$(curl -fsSL --max-time 4 "$url" 2>/dev/null | head -c 100000 | tr '\n' ' ' || true)
    local touch_icon
    touch_icon=$(grep -oiE "<link[^>]*rel=[\"'][^\"']*apple-touch-icon[^\"']*[\"'][^>]*>" <<<"$page" |
        grep -oiE "href=[\"'][^\"']+" | head -1 | sed -E "s/^href=[\"']//" || true)

    if [[ -n "$touch_icon" ]]; then
        case "$touch_icon" in
            http://*|https://*) ;;
            //*) touch_icon="https:$touch_icon" ;;
            /*)  touch_icon="https://$domain$touch_icon" ;;
            *)   touch_icon="https://$domain/$touch_icon" ;;
        esac
        if curl -fsSL --max-time 5 -o "$dest" "$touch_icon" 2>/dev/null && [[ -s "$dest" && $(file -b --mime-type "$dest") == image/* ]]; then
            return 0
        fi
    fi

    # Try curated high-res 512px dashboard-icons
    local clean_name
    clean_name=$(printf '%s' "$domain" | sed -E 's/\.(com|org|net|io|ai|app|co|in)$//; s/.*\b(google|youtube|whatsapp|reddit|github|gmail|calendar|chatgpt|claude|gemini)\b.*/\1/')
    [[ "$clean_name" == "calendar" ]] && clean_name="google-calendar"
    if [[ -n "$clean_name" ]]; then
        if curl -fsSL --max-time 4 -o "$dest" "https://raw.githubusercontent.com/walkxcode/dashboard-icons/main/png/${clean_name}.png" 2>/dev/null; then
            if [[ -s "$dest" && $(file -b --mime-type "$dest") == image/* ]]; then
                return 0
            fi
        fi
    fi

    # Fallback to Google 256px Favicon API
    if curl -fsSL --max-time 5 -o "$dest" "https://www.google.com/s2/favicons?domain=${domain}&sz=256" 2>/dev/null; then
        if [[ -s "$dest" && $(file -b --mime-type "$dest") == image/* ]]; then
            return 0
        fi
    fi

    # Fallback: Copy standard internet web icon if available
    cp /usr/share/icons/hicolor/256x256/apps/chromium.png "$dest" 2>/dev/null || true
}

create_webapp() {
    local name="$1"
    local raw_url="$2"
    local icon_src="$3"

    if [[ -z "$name" || -z "$raw_url" ]]; then
        echo "Error: Name and URL are required."
        echo "Usage: webapp create <Name> <URL> [IconPathOrURL]"
        exit 1
    fi

    local url
    url=$(normalize_url "$raw_url")
    local id
    id=$(safe_name "$name")
    local icon_path="$ICONS_DIR/webapp-$id.png"
    local desktop_path="$APPS_DIR/webapp-$id.desktop"

    echo "📦 Creating web app '$name' ($url)..."

    # Handle Icon
    if [[ -n "$icon_src" ]]; then
        if [[ "$icon_src" =~ ^https?:// ]]; then
            curl -fsSL --max-time 5 -o "$icon_path" "$icon_src" || fetch_icon "$url" "$icon_path"
        elif [[ -f "$icon_src" ]]; then
            cp "$icon_src" "$icon_path"
        fi
    else
        fetch_icon "$url" "$icon_path"
    fi

    gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1 || true

    # Generate .desktop file
    cat > "$desktop_path" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=$name
Comment=$name Web Application
Exec=chromium --app="$url" --name="webapp-$id" --class="WebApp-$id"
Icon=webapp-$id
Terminal=false
StartupNotify=true
Categories=Network;WebApplication;
StartupWMClass=chrome-$id
EOF

    chmod +x "$desktop_path"
    update-desktop-database "$APPS_DIR" >/dev/null 2>&1 || true

    echo "✅ Successfully created web app: $name"
    echo "   Launcher: $desktop_path"
    echo "   Now available in wofi (Super + D) and app menus!"
    notify-send -i "$icon_path" "Web App Created" "$name has been added to your app launcher!" 2>/dev/null || true
}

list_webapps() {
    local found=0
    echo "📋 Installed Web Apps:"
    echo "──────────────────────────────────────────────"
    for f in "$APPS_DIR"/webapp-*.desktop; do
        if [[ -f "$f" ]]; then
            local name
            name=$(grep -E '^Name=' "$f" | head -1 | cut -d= -f2-)
            local exec_cmd
            exec_cmd=$(grep -E '^Exec=' "$f" | head -1 | cut -d= -f2-)
            local url
            url=$(grep -oE 'https?://[^ "]+' <<<"$exec_cmd" || echo "Unknown")
            printf " • \033[1;36m%-20s\033[0m %s\n" "$name" "$url"
            found=1
        fi
    done
    if (( ! found )); then
        echo "No web apps installed yet. Run 'webapp create <Name> <URL>' or 'webapp gui' to add one."
    fi
}

remove_webapp() {
    local name="$1"
    if [[ -z "$name" ]]; then
        # Interactive pick from installed web apps
        local apps=()
        for f in "$APPS_DIR"/webapp-*.desktop; do
            [[ -f "$f" ]] && apps+=("$(grep -E '^Name=' "$f" | head -1 | cut -d= -f2-)")
        done
        if (( ${#apps[@]} == 0 )); then
            echo "No web apps to remove."
            return
        fi
        local chosen
        chosen=$(printf '%s\n' "${apps[@]}" | wofi --dmenu -p "Select web app to delete:" -W 450 -H 300)
        [[ -z "$chosen" ]] && exit 0
        name="$chosen"
    fi

    local id
    id=$(safe_name "$name")
    local desktop_path="$APPS_DIR/webapp-$id.desktop"
    local icon_path="$ICONS_DIR/webapp-$id.png"

    if [[ -f "$desktop_path" ]]; then
        rm -f "$desktop_path" "$icon_path"
        update-desktop-database "$APPS_DIR" >/dev/null 2>&1 || true
        gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1 || true
        echo "🗑️ Removed web app: $name"
        notify-send "Web App Removed" "$name has been removed." 2>/dev/null || true
    else
        echo "Web app '$name' not found."
    fi
}

launch_webapp() {
    local name="$1"
    if [[ -z "$name" ]]; then
        local apps=()
        for f in "$APPS_DIR"/webapp-*.desktop; do
            [[ -f "$f" ]] && apps+=("$(grep -E '^Name=' "$f" | head -1 | cut -d= -f2-)")
        done
        if (( ${#apps[@]} == 0 )); then
            echo "No web apps installed."
            return
        fi
        local chosen
        chosen=$(printf '%s\n' "${apps[@]}" | wofi --dmenu -p "Launch Web App:" -W 450 -H 300)
        [[ -z "$chosen" ]] && exit 0
        name="$chosen"
    fi

    local id
    id=$(safe_name "$name")
    local desktop_path="$APPS_DIR/webapp-$id.desktop"
    if [[ -f "$desktop_path" ]]; then
        local cmd
        cmd=$(grep -E '^Exec=' "$desktop_path" | head -1 | cut -d= -f2-)
        eval "$cmd >/dev/null 2>&1 &"
    else
        echo "Web app '$name' not found."
    fi
}

gui_menu() {
    local choice
    choice=$(cat <<'EOF' | wofi --dmenu -p "Web App Manager" -W 500 -H 320
⚡ 1-Click Install Popular Web App
➕ Create Custom Web App
🚀 Launch Web App
🗑️ Remove Web App
📋 List Installed Web Apps
EOF
)

    case "$choice" in
        *"1-Click"*)
            local template
            template=$(cat <<'EOF' | wofi --dmenu -p "Choose Web App to Install" -W 500 -H 360
YouTube (https://youtube.com)
YouTube Music (https://music.youtube.com)
WhatsApp Web (https://web.whatsapp.com)
ChatGPT (https://chatgpt.com)
Claude AI (https://claude.ai)
GitHub (https://github.com)
Spotify (https://open.spotify.com)
Reddit (https://reddit.com)
Notion (https://notion.so)
Discord (https://discord.com/app)
Gmail (https://mail.google.com)
Twitter / X (https://x.com)
EOF
)
            [[ -z "$template" ]] && exit 0
            local name url
            name=$(cut -d'(' -f1 <<<"$template" | xargs)
            url=$(grep -oE 'https?://[^)]+' <<<"$template")
            create_webapp "$name" "$url"
            ;;

        *"Create Custom"*)
            local form
            form=$(zenity --forms --title="New Web App Maker" \
                --text="Create a standalone, frameless web application:" \
                --add-entry="Application Name (e.g. YouTube):" \
                --add-entry="Website URL (e.g. https://youtube.com):" 2>/dev/null || true)
            [[ -z "$form" ]] && exit 0
            local name url
            name=$(awk -F'|' '{print $1}' <<<"$form")
            url=$(awk -F'|' '{print $2}' <<<"$form")
            if [[ -n "$name" && -n "$url" ]]; then
                create_webapp "$name" "$url"
            fi
            ;;

        *"Launch"*)
            launch_webapp
            ;;

        *"Remove"*)
            remove_webapp
            ;;

        *"List"*)
            local list
            list=$(list_webapps)
            zenity --info --title="Installed Web Apps" --text="$list" --width=450 2>/dev/null || echo "$list"
            ;;
    esac
}

case "${1:-gui}" in
    create)
        create_webapp "$2" "$3" "$4"
        ;;
    list|ls)
        list_webapps
        ;;
    remove|rm|delete)
        remove_webapp "$2"
        ;;
    launch|open)
        launch_webapp "$2"
        ;;
    gui|menu)
        gui_menu
        ;;
    *)
        echo "Usage: webapp {create <Name> <URL>|list|remove [Name]|launch [Name]|gui}"
        exit 1
        ;;
esac
