ICON_PNG_CACHE = "/tmp/phone_bridge_icon_512.png"

def get_icon_png():
    if os.path.exists(ICON_PNG_CACHE):
        try:
            with open(ICON_PNG_CACHE, "rb") as f:
                return f.read()
        except Exception:
            pass
    try:
        res = subprocess.run(["rsvg-convert", "-w", "512", "-h", "512"], input=ICON_SVG.encode("utf-8"), capture_output=True, timeout=2.0)
        if res.returncode == 0 and res.stdout:
            with open(ICON_PNG_CACHE, "wb") as f:
                f.write(res.stdout)
            return res.stdout
    except Exception:
        pass
    return b""

