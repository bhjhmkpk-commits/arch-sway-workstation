PORT = 8088
TOKEN_FILE = f"/tmp/phone_clip_token_{os.getuid()}"
IMAGE_CACHE = "/tmp/phone_clip_image.png"

# Thread-safe event broadcaster for Server-Sent Events (SSE)
sse_clients = []
sse_lock = threading.Lock()
log_queue = queue.Queue()

def get_local_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("1.1.1.1", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"

def get_or_create_token():
    if os.path.exists(TOKEN_FILE):
        try:
            with open(TOKEN_FILE, "r") as f:
                token = f.read().strip()
                if token and len(token) >= 6:
                    return token
        except Exception:
            pass
    token = secrets.token_hex(3) # 6 character hex token e.g. "a7c080"
    try:
        with open(TOKEN_FILE, "w") as f:
            f.write(token)
    except Exception:
        pass
    return token

SESSION_TOKEN = get_or_create_token()

def log_event(emoji, message):
    ts = time.strftime("%H:%M:%S")
    entry = f"[{ts}] {emoji} {message}"
    print(entry, flush=True)
    broadcast_sse("log", f"{emoji} {message}")

def broadcast_sse(event_type, payload):
    data = json.dumps({"type": event_type, "data": payload, "ts": time.time()})
    with sse_lock:
        for q in list(sse_clients):
            try:
                q.put_nowait(data)
            except Exception:
                pass

def get_laptop_clipboard():
    try:
        types_out = subprocess.run(["wl-paste", "-l"], capture_output=True, text=True, timeout=1.5)
        types = types_out.stdout if types_out.returncode == 0 else ""
        if "image/png" in types or "image/jpeg" in types:
            img_res = subprocess.run(["wl-paste", "-t", "image/png"], capture_output=True, timeout=2.0)
            if img_res.returncode == 0 and img_res.stdout:
                with open(IMAGE_CACHE, "wb") as f:
                    f.write(img_res.stdout)
                return {
                    "type": "image",
                    "content": "/clip/image?" + str(int(time.time())),
                    "size": len(img_res.stdout),
                    "length": len(img_res.stdout)
                }
        text_res = subprocess.run(["wl-paste"], capture_output=True, text=True, timeout=1.5, errors="ignore")
        if text_res.returncode == 0 and text_res.stdout:
            text = text_res.stdout
            return {"type": "text", "content": text, "length": len(text)}
        return {"type": "empty", "content": "", "length": 0}
    except Exception:
        return {"type": "empty", "content": "", "length": 0}

def set_laptop_clipboard(text):
    try:
        p = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE)
        p.communicate(input=text.encode("utf-8"), timeout=2.0)
        preview = text.strip()[:80].replace("\n", " ")
        subprocess.run(["notify-send", "-a", "Phone Bridge", "-i", "edit-paste", "Copied from Phone", preview or "Text received"])
        log_event("📋", f"Text copied from phone ({len(text)} chars)")
        broadcast_sse("clip_updated", {"type": "text", "content": text, "length": len(text)})
        return True
    except Exception as e:
        log_event("❌", f"Error setting clipboard: {e}")
        return False

def set_laptop_clipboard_image(image_bytes):
    try:
        save_dir = os.path.expanduser("~/Pictures/Screenshots")
        os.makedirs(save_dir, exist_ok=True)
        filename = f"phone_photo_{int(time.time())}.png"
        filepath = os.path.join(save_dir, filename)
        with open(filepath, "wb") as f:
            f.write(image_bytes)

        p = subprocess.Popen(["wl-copy", "-t", "image/png"], stdin=subprocess.PIPE)
        p.communicate(input=image_bytes, timeout=3.0)
        size_kb = len(image_bytes) // 1024
        subprocess.run(["notify-send", "-a", "Phone Bridge", "-i", "camera-photo", "Photo Received from Phone!", f"Copied to clipboard & saved ({size_kb} KB)"])
        log_event("📸", f"Photo received and copied to clipboard ({size_kb} KB)")
        broadcast_sse("clip_updated", {"type": "image", "content": "/clip/image?" + str(int(time.time())), "size": len(image_bytes)})
        return True
    except Exception as e:
        log_event("❌", f"Error setting image clipboard: {e}")
        return False

def save_uploaded_file(filename, file_bytes):
    try:
        downloads_dir = os.path.expanduser("~/Downloads")
        os.makedirs(downloads_dir, exist_ok=True)
        # Sanitize filename
        safe_name = os.path.basename(filename).strip() or f"phone_file_{int(time.time())}.bin"
        safe_name = re.sub(r'[^\w\-_\. ]', '_', safe_name)
        
        target_path = os.path.join(downloads_dir, safe_name)
        base, ext = os.path.splitext(safe_name)
        counter = 1
        while os.path.exists(target_path):
            target_path = os.path.join(downloads_dir, f"{base}_{counter}{ext}")
            counter += 1

        with open(target_path, "wb") as f:
            f.write(file_bytes)

        size_mb = len(file_bytes) / (1024 * 1024)
        size_str = f"{size_mb:.2f} MB" if size_mb >= 1.0 else f"{len(file_bytes) // 1024} KB"
        saved_filename = os.path.basename(target_path)
        subprocess.run(["notify-send", "-a", "Phone Bridge", "-i", "document-save", "File Received from Phone!", f"{saved_filename} ({size_str}) -> ~/Downloads"])
        log_event("📁", f"File received: {saved_filename} ({size_str}) -> ~/Downloads")
        return {"status": "ok", "filename": saved_filename, "size_str": size_str}
    except Exception as e:
        log_event("❌", f"Error saving file: {e}")
        return {"status": "error", "message": str(e)}

def open_url_on_workstation(url):
    try:
        url = url.strip()
        if not (url.startswith("http://") or url.startswith("https://")):
            url = "https://" + url
        subprocess.Popen(["xdg-open", url])
        subprocess.run(["notify-send", "-a", "Phone Bridge", "-i", "web-browser", "Opened Link from Phone", url[:80]])
        log_event("🌐", f"Opened link on PC: {url}")
        return True
    except Exception as e:
        log_event("❌", f"Error opening URL: {e}")
        return False

def get_clip_history(limit=16):
    try:
        out = subprocess.check_output(["cliphist", "list"], stderr=subprocess.DEVNULL, timeout=2.0).decode("utf-8", errors="ignore")
        items = []
        for line in out.strip().splitlines()[:limit]:
            if "\t" in line:
                cid, text = line.split("\t", 1)
                cid = cid.strip()
                text = text.strip()
                is_binary = text.startswith("[[ binary data")
                full_text = ""
                if not is_binary:
                    try:
                        raw = subprocess.check_output(["cliphist", "decode", cid], stderr=subprocess.DEVNULL, timeout=0.4)
                        full_text = raw.decode("utf-8", errors="ignore")
                    except Exception:
                        full_text = text
                items.append({
                    "id": cid,
                    "preview": text[:120],
                    "text": full_text,
                    "is_binary": is_binary
                })
        return items
    except Exception:
        return []

def decode_history_item(cid):
    try:
        data = subprocess.check_output(["cliphist", "decode", str(cid)], stderr=subprocess.DEVNULL, timeout=2.0)
        try:
            text = data.decode("utf-8")
            return {"type": "text", "content": text}
        except UnicodeDecodeError:
            return {"type": "image", "content": f"/history/image/{cid}"}
    except Exception:
        return {"type": "empty", "content": ""}

# Background thread watching PC clipboard
class ClipboardWatcher(threading.Thread):
    def __init__(self):
        super().__init__(daemon=True)
        self.last_content = None
        self.last_type = None

    def run(self):
        while True:
            try:
                clip = get_laptop_clipboard()
                c_type = clip.get("type")
                content = clip.get("content", "")
                if (c_type != self.last_type) or (content != self.last_content):
                    self.last_type = c_type
                    self.last_content = content
                    broadcast_sse("clip_updated", clip)
            except Exception:
                pass
            time.sleep(0.4)

