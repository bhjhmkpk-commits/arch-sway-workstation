        <div class="file-drop-zone" onclick="document.getElementById('file-input').click()">
          <span style="font-size: 32px; display: block; margin-bottom: 8px;">📂</span>
          <span style="font-weight: 700; color: var(--green);">Tap to Choose File</span>
          <p style="font-size: 12px; color: var(--muted); margin: 4px 0 0 0;">or drag & drop here</p>
        </div>
        <input type="file" id="file-input" style="display:none;" onchange="uploadSelectedFile(this)">
      </div>

      <div class="card">
        <h2 class="card-title">📸 Camera Snapshot to PC</h2>
        <p style="font-size: 13px; color: var(--muted); margin-top: 4px;">Snap a photo; immediately copied to PC clipboard!</p>
        <button class="btn btn-yellow" onclick="document.getElementById('camera-input').click()">
          <span>📷 Take Photo / Scan</span>
        </button>
        <input type="file" id="camera-input" accept="image/*" capture="environment" style="display:none;" onchange="uploadCameraPhoto(this)">
      </div>
    </div>

    <!-- TAB 4: OPEN LINK ON PC -->
    <div id="tab-link" class="tab-content">
      <div class="card">
        <h2 class="card-title">🌐 Open URL on PC Desktop</h2>
        <p style="font-size: 13px; color: var(--muted); margin-top: 4px;">Opens instantly in Brave Origin browser on your workstation.</p>
        <input type="url" id="link-input" placeholder="https://youtube.com/... or any link">
        <button class="btn btn-green" onclick="openUrlOnPc()">
          <span>🚀 Open in PC Browser</span>
        </button>
      </div>
    </div>

  </main>

  <div id="toast" class="toast">✓ Copied!</div>

  <!-- AUTH PIN MODAL -->
  <div id="auth-overlay">
    <div class="auth-card">
      <h2 style="color: var(--green); margin-top: 0;">🔐 Workstation PIN</h2>
      <p style="font-size: 13px; color: var(--muted);">Enter the 6-character PIN shown on your PC terminal screen:</p>
      <input type="text" id="auth-input" maxlength="8" style="text-align: center; font-size: 20px; font-weight: bold; letter-spacing: 4px; text-transform: uppercase;">
      <button class="btn btn-green" onclick="submitAuthPin()" style="margin-top: 14px;">Connect</button>
    </div>
  </div>

  <!-- MANUAL COPY MODAL (Browser restriction fallback) -->
  <div id="manual-copy-modal" style="position:fixed;inset:0;background:rgba(30,35,38,0.95);display:none;align-items:center;justify-content:center;z-index:2500;padding:20px;">
    <div class="auth-card" style="max-width:440px;width:100%;">
      <h3 style="color:var(--green);margin-top:0;">📋 Copy Text</h3>
      <p style="font-size:13px;color:var(--muted);margin-bottom:8px;">Tap and hold inside the box below to select and copy:</p>
      <textarea id="manual-copy-ta" rows="6" readonly style="font-size:15px;line-height:1.4;margin-bottom:12px;user-select:all;-webkit-user-select:all;"></textarea>
      <button class="btn btn-green" onclick="closeManualCopy()">Done</button>
    </div>
  </div>

  <script>
    let currentClipText = "";
    let authToken = "";

    // 1. Initialize Auth Token from URL or localStorage
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get("auth")) {
      authToken = urlParams.get("auth");
      localStorage.setItem("phone_clip_token", authToken);
      // Clean URL query
      window.history.replaceState({}, document.title, window.location.pathname);
    } else {
      authToken = localStorage.getItem("phone_clip_token") || "";
    }

    function checkAuth() {
      if (!authToken) {
        document.getElementById("auth-overlay").style.display = "flex";
      } else {
        document.getElementById("auth-overlay").style.display = "none";
        initLiveSync();
      }
    }

    function submitAuthPin() {
      const pin = document.getElementById("auth-input").value.trim().toLowerCase();
      if (!pin) return;
      authToken = pin;
      localStorage.setItem("phone_clip_token", authToken);
      document.getElementById("auth-overlay").style.display = "none";
      initLiveSync();
    }

    function showToast(msg) {
      const t = document.getElementById("toast");
      t.innerText = msg;
      t.classList.add("show");
      setTimeout(() => t.classList.remove("show"), 2200);
    }

    function switchTab(tabId) {
      document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
      document.querySelectorAll(".tab-content").forEach(c => c.classList.remove("active"));
      event.target.classList.add("active");
      document.getElementById("tab-" + tabId).classList.add("active");
      if (tabId === "history") loadHistory();
    }

    // 2. BULLETPROOF MOBILE COPY SYSTEM
    function copyCurrentToPhone(btn) {
      if (!currentClipText) {
        showToast("⚠️ Clipboard is empty!");
        return;
      }
      smartCopyText(currentClipText, btn);
    }

    function smartCopyText(text, btn) {
      if (!text) return;
      // 1. Try modern async clipboard API first if available in secure context
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(() => {
          onCopySuccess(btn);
        }).catch(() => {
          fallbackExecCopy(text, btn);
        });
        return;
      }
      // 2. Synchronous execCommand fallback (Primary for mobile LAN HTTP)
      fallbackExecCopy(text, btn);
    }

    function fallbackExecCopy(text, btn) {
      let success = false;
      const isIOS = /ipad|iphone|ipod/i.test(navigator.userAgent);
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.fontSize = "16px"; // Prevents iOS Safari auto-zoom
      ta.style.position = "fixed";
      ta.style.left = "-9999px";
      ta.style.top = (window.pageYOffset || document.documentElement.scrollTop) + "px";
      ta.setAttribute("readonly", "");
      document.body.appendChild(ta);

      if (isIOS) {
        ta.contentEditable = "true";
        ta.readOnly = false;
        const range = document.createRange();
        range.selectNodeContents(ta);
        const sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
        ta.setSelectionRange(0, text.length);
      } else {
        ta.focus();
        ta.select();
        ta.setSelectionRange(0, text.length);
      }

      try {
        success = document.execCommand("copy");
      } catch (err) {
        success = false;
      }
      document.body.removeChild(ta);

      if (success) {
        onCopySuccess(btn);
      } else {
        // Selection fallback on display box
        try {
          const el = document.getElementById("clip-display");
          selectElementContents(el);
          const copy2 = document.execCommand("copy");
          if (copy2) {
            onCopySuccess(btn);
            window.getSelection().removeAllRanges();
            return;
          }
        } catch (e) {}
        showManualCopy(text);
      }
    }

    function selectElementContents(el) {
      const range = document.createRange();
      range.selectNodeContents(el);
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    }

    function showManualCopy(text) {
      const modal = document.getElementById("manual-copy-modal");
      const ta = document.getElementById("manual-copy-ta");
      ta.value = text;
      modal.style.display = "flex";
      ta.focus();
      ta.select();
      showToast("Tap & hold text to Copy");
    }

    function closeManualCopy() {
      document.getElementById("manual-copy-modal").style.display = "none";
    }

    function onCopySuccess(btn) {
      if (navigator.vibrate) {
        try { navigator.vibrate([30, 20, 30]); } catch(e) {}
      }
      showToast("✓ Copied to Phone Clipboard!");
      if (btn) {
        const originalHtml = btn.innerHTML;
        btn.innerHTML = "<span>✓ Copied!</span>";
        btn.style.background = "#859289";
        setTimeout(() => {
          btn.innerHTML = originalHtml;
          btn.style.background = "";
        }, 1600);
      }
    }

    // 3. Real-Time Server-Sent Events (SSE) Stream
    function initLiveSync() {
      fetchClipDirect();

      if (window.EventSource) {
        const es = new EventSource("/events?auth=" + encodeURIComponent(authToken));
        es.onmessage = function(e) {
          try {
            const msg = JSON.parse(e.data);
            if (msg.type === "clip_updated") {
              renderClipboard(msg.data);
            }
          } catch(err) {}
        };
        es.onerror = function() {
          document.getElementById("status-text").innerText = "Reconnecting...";
          document.querySelector(".dot").style.background = "var(--yellow)";
        };
        es.onopen = function() {
          document.getElementById("status-text").innerText = "Live Sync";
          document.querySelector(".dot").style.background = "var(--green)";
        };
      }
    }

    function fetchClipDirect() {
      fetch("/clip?auth=" + encodeURIComponent(authToken))
        .then(r => {
          if (r.status === 401) {
            document.getElementById("auth-overlay").style.display = "flex";
            throw new Error("Unauthorized");
          }
          return r.json();
        })
        .then(data => renderClipboard(data))
        .catch(e => {});
    }

    function renderClipboard(data) {
      const box = document.getElementById("clip-display");
      const timeLabel = document.getElementById("clip-time");
      const meta = document.getElementById("clip-meta");
      timeLabel.innerText = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

      if (data.type === "image") {
        currentClipText = "";
        box.innerHTML = `<img src="${data.content}" class="clip-image-preview" alt="Copied Image"><a href="${data.content}" download="pc_image.png" class="btn btn-secondary" style="margin-top:8px;">⬇️ Download Image (${Math.round((data.size || 0)/1024)} KB)</a>`;
        if (meta) meta.innerText = `Image • ${Math.round((data.size || 0)/1024)} KB`;
        document.getElementById("btn-copy-phone").style.display = "none";
      } else if (data.type === "text" && data.content) {
        currentClipText = data.content;
        box.innerText = data.content;
        if (meta) {
          const chars = data.content.length;
          const words = data.content.trim().split(/\s+/).filter(Boolean).length;
          meta.innerText = `${chars} chars • ${words} words`;
        }
        document.getElementById("btn-copy-phone").style.display = "flex";
      } else {
        currentClipText = "";
        box.innerHTML = '<span style="color: var(--muted); font-style: italic;">(Workstation clipboard is empty)</span>';
        if (meta) meta.innerText = "";
        document.getElementById("btn-copy-phone").style.display = "none";
      }
    }

    // 4. Send to PC Clipboard
    function sendToPcClipboard() {
      const text = document.getElementById("phone-input").value;
      if (!text || !text.trim()) {
        showToast("⚠️ Enter some text first");
        return;
      }
      fetch("/send?auth=" + encodeURIComponent(authToken), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text: text })
      })
      .then(r => r.json())
      .then(d => {
        showToast("🚀 Sent to Workstation Clipboard!");
        document.getElementById("phone-input").value = "";
      })
      .catch(e => showToast("Error sending text"));
    }

    // 5. File Upload (Any File)
    function uploadSelectedFile(input) {
      if (!input.files || !input.files[0]) return;
      const file = input.files[0];
      showToast("⏳ Uploading " + file.name + "...");
      fetch("/upload-file?auth=" + encodeURIComponent(authToken), {
        method: "POST",
        headers: { "X-Filename": encodeURIComponent(file.name) },
        body: file
      })
      .then(r => r.json())
      .then(d => {
        showToast("✓ " + d.filename + " saved to ~/Downloads!");
        input.value = "";
      })
      .catch(e => showToast("Error uploading file"));
    }

    // 6. Camera Photo Upload
    function uploadCameraPhoto(input) {
      if (!input.files || !input.files[0]) return;
      const file = input.files[0];
      showToast("⏳ Sending photo to PC clipboard...");
      fetch("/upload-photo?auth=" + encodeURIComponent(authToken), {
        method: "POST",
        body: file
      })
      .then(r => r.json())
      .then(d => {
        showToast("📸 Photo pasted to PC clipboard!");
        input.value = "";
      })
      .catch(e => showToast("Error uploading photo"));
    }

    // 7. Open Link on PC
    function openUrlOnPc() {
      const url = document.getElementById("link-input").value.trim();
      if (!url) {
        showToast("⚠️ Enter a valid URL");
        return;
      }
      fetch("/open-url?auth=" + encodeURIComponent(authToken), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ url: url })
      })
      .then(r => r.json())
      .then(d => {
        showToast("🌐 Opened in Brave on PC!");
        document.getElementById("link-input").value = "";
      })
      .catch(e => showToast("Error opening link"));
    }

    // 8. Cliphist History with Synchronous Zero-Latency Copy
    let historyCache = [];

    function loadHistory() {
      const list = document.getElementById("history-list");
      list.innerHTML = '<span style="color: var(--muted);">Loading history...</span>';
      fetch("/history?auth=" + encodeURIComponent(authToken))
        .then(r => r.json())
        .then(items => {
          historyCache = items || [];
          if (!historyCache || historyCache.length === 0) {
            list.innerHTML = '<span style="color: var(--muted); font-style: italic;">No history items found.</span>';
            return;
          }
          list.innerHTML = "";
          historyCache.forEach((item, index) => {
            const div = document.createElement("div");
            div.className = "history-item";
            const isBin = item.is_binary;
            div.innerHTML = `
              <div class="history-text">${isBin ? '🖼️ <i>Image / Binary Data</i>' : escapeHtml(item.preview)}</div>
              <div class="history-actions">
                ${!isBin ? `<button class="btn-mini" onclick="copyHistoryItem(${index}, this)">📋 Copy</button>` : ''}
                <button class="btn-mini" onclick="restoreHistoryToPc('${item.id}')">💻 Set PC</button>
              </div>
            `;
            list.appendChild(div);
          });
        })
        .catch(e => {
          list.innerHTML = '<span style="color: var(--red);">Error loading history</span>';
        });
    }

    function copyHistoryItem(index, btn) {
      const item = historyCache[index];
      if (item && item.text) {
        smartCopyText(item.text, btn);
      } else {
        showToast("Item is binary data");
      }
    }

    function restoreHistoryToPc(id) {
      fetch("/history/restore?id=" + encodeURIComponent(id) + "&auth=" + encodeURIComponent(authToken), { method: "POST" })
        .then(r => r.json())
        .then(d => showToast("✓ Restored to PC Clipboard!"));
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.innerText = text;
      return div.innerHTML;
    }

    function dismissPwaHint() {
      const hint = document.getElementById('pwa-hint');
      if (hint) hint.style.display = 'none';
      localStorage.setItem('dismiss_pwa_hint', 'true');
    }

    if (!window.matchMedia('(display-mode: standalone)').matches && !localStorage.getItem('dismiss_pwa_hint')) {
      const hint = document.getElementById('pwa-hint');
      if (hint) hint.style.display = 'flex';
    }

    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }

    checkAuth();
  </script>
</body>
</html>
"""

class PhoneBridgeHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass # Suppress default noisy access logs

    def is_authorized(self):
        parsed = urllib.parse.urlparse(self.path)
        params = urllib.parse.parse_qs(parsed.query)
        # Check query param ?auth=...
        if params.get("auth", [""])[0].lower() == SESSION_TOKEN.lower():
            return True
        # Check header X-Auth-Token
        if self.headers.get("X-Auth-Token", "").lower() == SESSION_TOKEN.lower():
            return True
        # Allow initial HTML page load, favicon, status check, and PWA assets
        if parsed.path in ("/", "/index.html", "/favicon.ico", "/status", "/manifest.json", "/sw.js", "/icon.svg", "/icon.png"):
            return True
        return False

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        params = urllib.parse.parse_qs(parsed.query)

        if path in ("/", "/index.html"):
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(HTML_MOBILE_APP.encode("utf-8"))
            return

        if path == "/favicon.ico":
            self.send_response(204)
            self.end_headers()
            return

        if path == "/manifest.json":
            self.send_response(200)
            self.send_header("Content-Type", "application/manifest+json; charset=utf-8")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(MANIFEST_JSON.encode("utf-8"))
            return

        if path == "/sw.js":
            self.send_response(200)
            self.send_header("Content-Type", "application/javascript; charset=utf-8")
            self.end_headers()
            self.wfile.write(SW_JS.encode("utf-8"))
            return

        if path == "/icon.svg":
            self.send_response(200)
            self.send_header("Content-Type", "image/svg+xml")
            self.end_headers()
            self.wfile.write(ICON_SVG.encode("utf-8"))
            return

        if path == "/icon.png":
            png_bytes = get_icon_png()
            if png_bytes:
                self.send_response(200)
                self.send_header("Content-Type", "image/png")
                self.send_header("Content-Length", str(len(png_bytes)))
                self.end_headers()
                self.wfile.write(png_bytes)
            else:
                self.send_error(404)
            return

        if path == "/status":
            has_auth = (params.get("auth", [""])[0].lower() == SESSION_TOKEN.lower() or
                        self.headers.get("X-Auth-Token", "").lower() == SESSION_TOKEN.lower())
            resp_data = {
                "status": "online",
                "ip": get_local_ip(),
                "port": PORT
            }
            if has_auth:
                resp_data["token"] = SESSION_TOKEN
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(resp_data).encode("utf-8"))
            return

        if not self.is_authorized():
            self.send_response(401)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"error": "Unauthorized. PIN required."}).encode("utf-8"))
            return

        if path == "/events":
            # Server-Sent Events (SSE) Stream
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Connection", "keep-alive")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()

            q = queue.Queue()
            with sse_lock:
                sse_clients.append(q)
            log_event("📱", "Phone connected to live sync")

            try:
                # Send initial state
                initial_clip = get_laptop_clipboard()
                init_msg = json.dumps({"type": "clip_updated", "data": initial_clip})
                self.wfile.write(f"data: {init_msg}\n\n".encode("utf-8"))
                self.wfile.flush()

                while True:
                    try:
                        msg = q.get(timeout=25)
                        self.wfile.write(f"data: {msg}\n\n".encode("utf-8"))
                        self.wfile.flush()
                    except queue.Empty:
                        self.wfile.write(b": ping\n\n")
                        self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError):
                pass
            finally:
                with sse_lock:
                    if q in sse_clients:
                        sse_clients.remove(q)
                log_event("📱", "Phone disconnected")
            return

        elif path == "/clip":
            clip = get_laptop_clipboard()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(clip).encode("utf-8"))
            return

        elif path.startswith("/clip/image"):
            if os.path.exists(IMAGE_CACHE):
                with open(IMAGE_CACHE, "rb") as f:
                    img_data = f.read()
                self.send_response(200)
                self.send_header("Content-Type", "image/png")
                self.send_header("Content-Length", str(len(img_data)))
                self.end_headers()
                self.wfile.write(img_data)
            else:
                self.send_error(404)
            return

        elif path == "/history":
            items = get_clip_history(limit=16)
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(items).encode("utf-8"))
            return

        elif path == "/history/item":
            params = urllib.parse.parse_qs(parsed.query)
            cid = params.get("id", [""])[0]
            item = decode_history_item(cid)
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(item).encode("utf-8"))
            return

        elif path.startswith("/history/image/"):
            cid = path.split("/")[-1]
            try:
                img_data = subprocess.check_output(["cliphist", "decode", str(cid)], stderr=subprocess.DEVNULL)
                self.send_response(200)
                self.send_header("Content-Type", "image/png")
                self.send_header("Content-Length", str(len(img_data)))
                self.end_headers()
                self.wfile.write(img_data)
            except Exception:
                self.send_error(404)
            return

        else:
            self.send_error(404)

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        if not self.is_authorized():
            self.send_response(401)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"error": "Unauthorized"}).encode("utf-8"))
            return

        length = int(self.headers.get("Content-Length", 0))

        if path == "/send":
            body = self.rfile.read(length).decode("utf-8", errors="ignore")
            try:
                data = json.loads(body)
                text = data.get("text", "")
                if text:
                    set_laptop_clipboard(text)
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.end_headers()
                    self.wfile.write(json.dumps({"status": "ok"}).encode("utf-8"))
                    return
            except Exception:
                pass
            self.send_error(400)

        elif path == "/upload-photo":
            try:
                if length > 0:
                    image_bytes = self.rfile.read(length)
                    set_laptop_clipboard_image(image_bytes)
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.end_headers()
                    self.wfile.write(json.dumps({"status": "ok"}).encode("utf-8"))
                    return
            except Exception as e:
                log_event("❌", f"Upload photo error: {e}")
            self.send_error(400)

        elif path == "/upload-file":
            try:
                if length > 0:
                    raw_filename = self.headers.get("X-Filename", "")
                    filename = urllib.parse.unquote(raw_filename) if raw_filename else f"file_{int(time.time())}.bin"
                    file_bytes = self.rfile.read(length)
                    res = save_uploaded_file(filename, file_bytes)
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.end_headers()
                    self.wfile.write(json.dumps(res).encode("utf-8"))
                    return
            except Exception as e:
                log_event("❌", f"Upload file error: {e}")
            self.send_error(400)

        elif path == "/open-url":
            body = self.rfile.read(length).decode("utf-8", errors="ignore")
            try:
                data = json.loads(body)
                url = data.get("url", "")
                if url:
                    open_url_on_workstation(url)
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.end_headers()
                    self.wfile.write(json.dumps({"status": "ok"}).encode("utf-8"))
                    return
            except Exception:
                pass
            self.send_error(400)

        elif path == "/history/restore":
            params = urllib.parse.parse_qs(parsed.query)
            cid = params.get("id", [""])[0]
            if cid:
                try:
                    subprocess.run(f"cliphist decode {cid} | wl-copy", shell=True, check=True)
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.end_headers()
                    self.wfile.write(json.dumps({"status": "ok"}).encode("utf-8"))
                    return
                except Exception:
                    pass
            self.send_error(400)

        else:
            self.send_error(404)

class ThreadingHTTPServer(http.server.ThreadingHTTPServer):
    daemon_threads = True

def main():
    ip = get_local_ip()
    url = f"http://{ip}:{PORT}/?auth={SESSION_TOKEN}"
    is_interactive = sys.stdout.isatty()

    # Check if another instance is already running
    is_already_running = False
    try:
        test_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        test_sock.settimeout(0.5)
        test_sock.connect(("127.0.0.1", PORT))
        test_sock.close()
        is_already_running = True
    except Exception:
        is_already_running = False

    if is_interactive:
        # Clear screen and display modern terminal dashboard
        print("\033[2J\033[H", end="") # Clear terminal
        GREEN = "\033[38;2;167;192;128m"
        BLUE = "\033[38;2;127;187;179m"
        YELLOW = "\033[38;2;219;188;127m"
        BOLD = "\033[1m"
        RESET = "\033[0m"

        print(f"{GREEN}{BOLD}╔═════════════════════════════════════════════════════════════════════════╗{RESET}")
        print(f"{GREEN}{BOLD}║         📱 Arch Sway Workstation — Phone <> PC Bridge 2.0               ║{RESET}")
        print(f"{GREEN}{BOLD}╚═════════════════════════════════════════════════════════════════════════╝{RESET}\n")

        # Render ANSI QR Code directly in terminal
        try:
            subprocess.run(["qrencode", "-t", "ansiutf8", url])
        except Exception:
            print(f"  Install qrencode to view QR in terminal: sudo pacman -S qrencode")

        print(f"\n  {BOLD}🔗 Mobile URL  :{RESET} {BLUE}{url}{RESET}")
        print(f"  {BOLD}🔑 PIN Code    :{RESET} {YELLOW}{SESSION_TOKEN}{RESET}")
        print(f"  {BOLD}⚡ Active Sync :{RESET} 0ms SSE Stream • History • File Drop • Link Launch")
        print(f"  {BOLD}📶 Server      :{RESET} {GREEN}http://{ip}:{PORT}{RESET} • Press {BOLD}Ctrl+C{RESET} to exit\n")
        print(f"{GREEN}── Live Activity Log ────────────────────────────────────────────────────────{RESET}")
        log_event("🚀", "Bridge dashboard ready. Standing by for mobile connections.")
    else:
        log_event("🚀", f"Bridge server running on http://{ip}:{PORT}")

    if is_already_running:
        if is_interactive:
            log_event("ℹ️", "Background daemon active. Connected to live stream.")
            try:
                req = urllib.request.Request(
                    f"http://127.0.0.1:{PORT}/events?auth={SESSION_TOKEN}",
                    headers={"User-Agent": "phone-clip-cli"}
                )
                with urllib.request.urlopen(req, timeout=86400) as resp:
                    for line in resp:
                        raw = line.decode("utf-8", errors="ignore").strip()
                        if raw.startswith("data:"):
                            try:
                                msg = json.loads(raw[5:].strip())
                                mtype = msg.get("type")
                                if mtype == "clip_updated":
                                    data = msg.get("data", {})
                                    c_type = data.get("type", "text")
                                    if c_type == "image":
                                        log_event("📸", f"Clipboard image updated ({data.get('size', 0)//1024} KB)")
                                    elif c_type == "text":
                                        txt = data.get("content", "").strip()[:50].replace("\n", " ")
                                        log_event("📋", f"Clipboard text updated: {txt}...")
                                elif mtype == "log":
                                    print(f"[{time.strftime('%H:%M:%S')}] {msg.get('data')}", flush=True)
                            except Exception:
                                pass
            except KeyboardInterrupt:
                print("\nDashboard closed.")
                sys.exit(0)
            except Exception:
                try:
                    while True:
                        time.sleep(1)
                except KeyboardInterrupt:
                    print("\nDashboard closed.")
                    sys.exit(0)
        else:
            sys.exit(0)

    # Start clipboard watcher thread
    watcher = ClipboardWatcher()
    watcher.start()

    try:
        server = ThreadingHTTPServer(("0.0.0.0", PORT), PhoneBridgeHandler)
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nBridge stopped cleanly.")
        sys.exit(0)
    except Exception as e:
        print(f"Server error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()
