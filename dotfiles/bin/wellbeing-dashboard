    def build_right_panel(self):
        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        
        # 1. 7-Day Chart Card
        chart_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        chart_card.get_style_context().add_class("card")
        
        c_head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        ch_title = Gtk.Label(xalign=0)
        ch_title.set_markup("<span weight='bold' color='#a7c080'>📊 Last 7 Days Screen Time</span> <span size='8500' color='#859289'>(Click bar to select)</span>")
        c_head.pack_start(ch_title, True, True, 0)
        
        self.avg_lbl = Gtk.Label(xalign=1)
        self.avg_lbl.set_markup("<span size='9500' color='#859289'>Daily Avg: 0h</span>")
        c_head.pack_end(self.avg_lbl, False, False, 0)
        chart_card.pack_start(c_head, False, False, 0)
        
        self.chart_area = Gtk.DrawingArea()
        self.chart_area.set_size_request(-1, 145)
        self.chart_area.set_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.chart_area.connect("draw", self.draw_weekly_chart)
        self.chart_area.connect("button-press-event", self.on_chart_clicked)
        chart_card.pack_start(self.chart_area, True, True, 0)
        
        panel.pack_start(chart_card, False, False, 0)
        
        # 2. Day-wise Top Apps Breakdown Card
        apps_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        apps_card.get_style_context().add_class("card")
        
        a_head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.app_card_title = Gtk.Label(xalign=0)
        self.app_card_title.set_markup("<span weight='bold' color='#a7c080'>📱 App Usage (Today)</span>")
        a_head.pack_start(self.app_card_title, True, True, 0)
        
        self.day_total_lbl = Gtk.Label(xalign=1)
        self.day_total_lbl.set_markup("<span size='9500' color='#859289'>Total: 0h</span>")
        a_head.pack_end(self.day_total_lbl, False, False, 0)
        apps_card.pack_start(a_head, False, False, 0)
        
        self.apps_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        apps_card.pack_start(self.apps_container, True, True, 0)
        panel.pack_start(apps_card, True, True, 0)
        
        return panel

    def get_7day_data(self):
        today = datetime.now().date()
        history = self.state.get("history", {})
        days = [today - timedelta(days=i) for i in range(6, -1, -1)]
        
        daily_sot = []
        weekly_apps = {}
        
        for d in days:
            d_str = d.strftime("%Y-%m-%d")
            day_name = d.strftime("%a")
            if d == today:
                sot = self.state.get("screen_time", {}).get("sot_seconds", 0)
                apps = self.state.get("screen_time", {}).get("apps", {})
            else:
                past = history.get(d_str, {})
                sot = past.get("sot_seconds", 0)
                apps = past.get("apps", {})
            
            sot_h = sot / 3600.0
            daily_sot.append({
                "date": d_str,
                "day": day_name,
                "sot_seconds": sot,
                "sot_hours": sot_h,
                "apps": apps,
                "is_today": (d == today)
            })
            for app, sec in apps.items():
                weekly_apps[app] = weekly_apps.get(app, 0) + sec
                
        return daily_sot, weekly_apps

    def on_chart_clicked(self, widget, event):
        if event.button == 1: # Left click
            width = widget.get_allocated_width()
            pad_left = 32
            pad_right = 16
            chart_w = width - pad_left - pad_right
            slot_w = chart_w / 7.0
            click_x = event.x - pad_left
            if 0 <= click_x <= chart_w:
                idx = int(click_x // slot_w)
                if 0 <= idx < 7:
                    self.selected_day_idx = idx
                    self.chart_area.queue_draw()
                    self.update_apps_ui()
                    return True
        return False

    def draw_weekly_chart(self, widget, cr):
        width = widget.get_allocated_width()
        height = widget.get_allocated_height()
        
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        
        daily_sot, _ = self.get_7day_data()
        goal_h = float(self.state.get("screen_time", {}).get("goal_hours", 6))
        
        max_h = max([d["sot_hours"] for d in daily_sot] + [goal_h, 3.5]) * 1.15
        
        pad_left = 32
        pad_right = 16
        pad_top = 22
        pad_bottom = 26
        
        chart_w = width - pad_left - pad_right
        chart_h = height - pad_top - pad_bottom
        
        # Goal horizontal line
        goal_y = pad_top + chart_h * (1.0 - (goal_h / max_h))
        cr.set_source_rgba(0.902, 0.494, 0.502, 0.55) # #e67e80
        cr.set_line_width(1.0)
        cr.set_dash([4.0, 4.0])
        cr.move_to(pad_left, goal_y)
        cr.line_to(width - pad_right, goal_y)
        cr.stroke()
        cr.set_dash([])
        
        cr.set_source_rgba(0.902, 0.494, 0.502, 0.85)
        cr.set_font_size(10)
        cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        cr.move_to(pad_left + 4, max(12, goal_y - 4))
        cr.show_text(f"Goal {int(goal_h)}h")
        
        # Baseline
        cr.set_source_rgb(0.235, 0.282, 0.255) # #3c4841
        cr.set_line_width(1.5)
        cr.move_to(pad_left, pad_top + chart_h)
        cr.line_to(width - pad_right, pad_top + chart_h)
        cr.stroke()
        
        # Draw 7 vertical bars
        n = len(daily_sot)
        slot_w = chart_w / n
        bar_w = min(36.0, slot_w * 0.62)
        
        for i, d in enumerate(daily_sot):
            cx = pad_left + i * slot_w + (slot_w / 2.0)
            bx = cx - (bar_w / 2.0)
            
            val_h = (d["sot_hours"] / max_h) * chart_h
            val_h = max(3.0, val_h)
            by = pad_top + chart_h - val_h
            
            is_selected = (i == self.selected_day_idx)
            
            if d["is_today"]:
                cr.set_source_rgb(0.498, 0.733, 0.702) # #7fbbb3 (Cyan)
            elif d["sot_hours"] > goal_h:
                cr.set_source_rgb(0.902, 0.494, 0.502) # #e67e80 (Red)
            else:
                cr.set_source_rgb(0.655, 0.753, 0.502) # #a7c080 (Green)
                
            radius = min(4.0, bar_w / 2.0)
            cr.new_sub_path()
            cr.arc(bx + bar_w - radius, by + radius, radius, -1.5707963, 0)
            cr.line_to(bx + bar_w, pad_top + chart_h)
            cr.line_to(bx, pad_top + chart_h)
            cr.arc(bx + radius, by + radius, radius, 3.1415926, 4.7123889)
            cr.close_path()
            cr.fill()
            
            # Active selection outline
            if is_selected:
                cr.set_source_rgba(0.95, 0.95, 0.95, 0.85)
                cr.set_line_width(1.8)
                cr.new_sub_path()
                cr.arc(bx + bar_w - radius, by + radius, radius, -1.5707963, 0)
                cr.line_to(bx + bar_w, pad_top + chart_h)
                cr.line_to(bx, pad_top + chart_h)
                cr.arc(bx + radius, by + radius, radius, 3.1415926, 4.7123889)
                cr.close_path()
                cr.stroke()
            
            # Text value above bar
            cr.set_source_rgb(0.827, 0.776, 0.667)
            cr.set_font_size(11)
            cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD if (d["is_today"] or is_selected) else cairo.FONT_WEIGHT_NORMAL)
            txt = f"{d['sot_hours']:.1f}h"
            ext = cr.text_extents(txt)
            cr.move_to(cx - (ext.width / 2.0), by - 5)
            cr.show_text(txt)
            
            # Day name below bar
            if is_selected or d["is_today"]:
                cr.set_source_rgb(0.498, 0.733, 0.702) if d["is_today"] else cr.set_source_rgb(0.95, 0.95, 0.95)
                cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            else:
                cr.set_source_rgb(0.522, 0.573, 0.537)
                cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
            cr.set_font_size(11)
            ext2 = cr.text_extents(d["day"])
            cr.move_to(cx - (ext2.width / 2.0), pad_top + chart_h + 16)
            cr.show_text(d["day"])
            
            # Selection dot indicator
            if is_selected:
                cr.set_source_rgb(0.498, 0.733, 0.702)
                cr.arc(cx, pad_top + chart_h + 23, 2.2, 0, 6.2831853)
                cr.fill()

    def update_left_ui(self):
        ec = self.state.get("eye_care", {})
        st = self.state.get("screen_time", {})
        
        rem = ec.get("remaining_seconds", 0)
        phase = ec.get("phase", "work")
        paused = ec.get("paused", False)
        cycles = ec.get("cycle_count", 0)
        
        self.timer_lbl.set_text(format_timer(rem))
        
        sc = self.phase_badge.get_style_context()
        sc.remove_class("badge-work")
        sc.remove_class("badge-break")
        sc.remove_class("badge-paused")
        
        if paused:
            self.phase_badge.set_markup("<span size='9000'>⏸ PAUSED</span>")
            sc.add_class("badge-paused")
            self.pause_btn.set_label("▶ Resume Timer")
        elif phase == "break":
            self.phase_badge.set_markup("<span size='9000'>☕ BREAK TIME</span>")
            sc.add_class("badge-break")
            self.pause_btn.set_label("⏸ Pause Timer")
        else:
            self.phase_badge.set_markup("<span size='9000'>🌿 FOCUS SESSION</span>")
            sc.add_class("badge-work")
            self.pause_btn.set_label("⏸ Pause Timer")
            
        self.cycle_lbl.set_markup(f"<span size='9500' color='#859289'>Cycle #{cycles} completed today  •  Live Tracking Active</span>")
        
        # Today's SOT & Goal
        sot_sec = st.get("sot_seconds", 0)
        goal_h = st.get("goal_hours", 6)
        pct = min(1.0, sot_sec / (goal_h * 3600.0)) if goal_h > 0 else 0.0
        
        self.sot_summary_lbl.set_markup(
            f"<span size='9500' color='#d3c6aa'>Today: <b>{format_sot(sot_sec)}</b> / Goal: <b>{goal_h}h 00m</b></span>"
        )
        self.goal_pct_lbl.set_markup(f"<span size='9500' weight='bold' color='#a7c080'>{int(pct*100)}% reached</span>")
        self.goal_bar.set_fraction(pct)
        
        # Highlight active goal button
        for h, btn in self.goal_buttons.items():
            btn_sc = btn.get_style_context()
            if h == goal_h:
                btn_sc.add_class("btn-active")
            else:
                btn_sc.remove_class("btn-active")
                
        # Highlight active preset button
        work_m = ec.get("work_duration", DEFAULT_WORK_MIN * 60) // 60
        break_m = ec.get("break_duration", DEFAULT_BREAK_MIN * 60) // 60
        for (wm, bm), btn in self.preset_buttons.items():
            btn_sc = btn.get_style_context()
            if wm == work_m and bm == break_m:
                btn_sc.add_class("btn-active")
            else:
                btn_sc.remove_class("btn-active")

    def update_apps_ui(self):
        daily_sot, weekly_apps = self.get_7day_data()
        
        total_sec_week = sum(weekly_apps.values())
        avg_h = (total_sec_week / 7.0) / 3600.0
        self.avg_lbl.set_markup(f"<span size='9500' color='#859289'>Daily Avg: <b>{avg_h:.1f}h</b></span>")
        
        if self.selected_day_idx >= len(daily_sot):
            self.selected_day_idx = len(daily_sot) - 1
            
        cur_day = daily_sot[self.selected_day_idx]
        day_apps = cur_day.get("apps", {})
        day_total_sec = cur_day.get("sot_seconds", 0)
        
        day_title = "Today" if cur_day["is_today"] else f"{cur_day['day']} ({cur_day['date']})"
        self.app_card_title.set_markup(f"<span weight='bold' color='#a7c080'>📱 App Usage: {day_title}</span>")
        self.day_total_lbl.set_markup(f"<span size='9500' color='#859289'>Total: <b>{format_sot(day_total_sec)}</b></span>")
        
        for child in self.apps_container.get_children():
            self.apps_container.remove(child)
            
        top_apps = sorted(day_apps.items(), key=lambda x: x[1], reverse=True)[:6]
        max_app_sec = top_apps[0][1] if top_apps else 1
        
        if not top_apps or day_total_sec == 0:
            empty_lbl = Gtk.Label(xalign=0.5)
            empty_lbl.set_markup("<span size='10000' color='#859289' style='italic'>No application usage recorded for this day.</span>")
            empty_lbl.set_margin_top(22)
            empty_lbl.set_margin_bottom(22)
            self.apps_container.pack_start(empty_lbl, True, True, 0)
        else:
            for idx, (app, sec) in enumerate(top_apps, 1):
                row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
                
                label_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
                name_lbl = Gtk.Label(xalign=0)
                name_lbl.set_markup(f"<span size='10000' weight='bold' color='#d3c6aa'>{idx}. {app}</span>")
                label_row.pack_start(name_lbl, True, True, 0)
                
                pct = (sec / day_total_sec * 100.0) if day_total_sec > 0 else 0
                time_lbl = Gtk.Label(xalign=1)
                time_lbl.set_markup(f"<span size='9500' color='#859289'>{format_sot(sec)}  •  {pct:.1f}%</span>")
                label_row.pack_end(time_lbl, False, False, 0)
                row.pack_start(label_row, False, False, 0)
                
                bar = Gtk.ProgressBar()
                bar.set_fraction(sec / max_app_sec)
                bar.get_style_context().add_class(f"rank-{idx}")
                row.pack_start(bar, False, False, 0)
                
                self.apps_container.pack_start(row, False, False, 0)
            
        self.apps_container.show_all()

    def send_cmd(self, cmd_dict):
        send_client_command(cmd_dict)
        self.state = self.fetch_state()
        self.update_left_ui()
        self.update_apps_ui()
        self.chart_area.queue_draw()

    def on_take_break(self, widget):
        self.send_cmd({"command": "skip"})

    def on_toggle_pause(self, widget):
        self.send_cmd({"command": "toggle"})

    def apply_preset(self, work_m, break_m):
        self.send_cmd({"command": "set_work", "minutes": work_m})
        self.send_cmd({"command": "set_break", "minutes": break_m})
        self.send_cmd({"command": "reset"})

    def set_goal(self, hours):
        self.send_cmd({"command": "set_goal", "hours": hours})

    def on_tick(self):
        self.state = self.fetch_state()
        self.update_left_ui()
        if self.selected_day_idx == 6: # If viewing Today, refresh live app breakdown
            self.update_apps_ui()
        self.chart_area.queue_draw()
        return True

def main():
    app = WellbeingDashboard()
    app.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
