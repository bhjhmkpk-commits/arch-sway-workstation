class WellbeingDashboard(Gtk.Window):
    def __init__(self):
        super().__init__(title="Digital Wellbeing & Eye Care")
        self.set_default_size(980, 640)
        self.set_position(Gtk.WindowPosition.CENTER)
        
        # Apply Everforest CSS
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS_DATA)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        
        self.connect("key-press-event", self.on_key_press)
        self.connect("delete-event", lambda *args: Gtk.main_quit())
        
        self.goal_buttons = {}
        self.preset_buttons = {}
        self.selected_day_idx = 6 # Default to Today (7th day)
        self.state = self.fetch_state()
        
        # Outer Layout
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        main_box.set_margin_top(16)
        main_box.set_margin_bottom(16)
        main_box.set_margin_start(18)
        main_box.set_margin_end(18)
        self.add(main_box)
        
        # Header Row
        main_box.pack_start(self.build_header(), False, False, 0)
        
        # Two-Column Body
        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        main_box.pack_start(body, True, True, 0)
        
        # Left Column (Controls & Live Eye Care Timer)
        left_panel = self.build_left_panel()
        left_panel.set_size_request(430, -1)
        body.pack_start(left_panel, False, False, 0)
        
        # Right Column (Cairo Chart & Top Apps)
        right_panel = self.build_right_panel()
        body.pack_start(right_panel, True, True, 0)
        
        # Initial UI synchronization
        self.update_left_ui()
        self.update_apps_ui()
        
        # 1-second live ticker
        GLib.timeout_add(1000, self.on_tick)

    def fetch_state(self):
        res = send_client_command({"command": "status"})
        if res and isinstance(res, dict) and "state" in res:
            return res["state"]
        return load_saved_state()

    def on_key_press(self, widget, event):
        if event.keyval in (Gdk.KEY_Escape, Gdk.KEY_q):
            Gtk.main_quit()
            return True
        return False

    def build_header(self):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        
        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_lbl = Gtk.Label(xalign=0)
        title_lbl.set_markup("<span size='16000' weight='bold' color='#d3c6aa'>🌿 Digital Wellbeing &amp; Screen Care</span>")
        sub_lbl = Gtk.Label(xalign=0)
        sub_lbl.set_markup("<span size='10000' color='#859289'>20-20-20 eye strain reminder, focus sprints &amp; weekly screen time analytics</span>")
        titles.pack_start(title_lbl, False, False, 0)
        titles.pack_start(sub_lbl, False, False, 0)
        box.pack_start(titles, True, True, 0)
        
        close_btn = Gtk.Button(label="✕ Close")
        close_btn.connect("clicked", lambda *args: Gtk.main_quit())
        box.pack_end(close_btn, False, False, 0)
        
        return box

