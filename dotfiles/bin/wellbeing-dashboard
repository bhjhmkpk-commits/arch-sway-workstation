#!/usr/bin/env python3
"""
🌿 Arch Sway Workstation - Native Digital Wellbeing & Eye Care Dashboard
Rich GTK 3 + Cairo graphical dashboard with 7-day screen time chart and app usage analytics.
Zero background idle load (runs purely on-demand, toggles closed with Esc or shortcut).
"""

import sys
import os
import json
import time
import socket
import subprocess
from pathlib import Path
from datetime import datetime, timedelta

# Check for existing instance and toggle close
current_pid = os.getpid()
try:
    pgrep_out = subprocess.run(["pgrep", "-f", "wellbeing-dashboard"], capture_output=True, text=True).stdout
    other_pids = [int(p) for p in pgrep_out.strip().split() if p and int(p) != current_pid]
    if other_pids:
        for p in other_pids:
            try:
                os.kill(p, 15) # SIGTERM
            except Exception:
                pass
        sys.exit(0)
except Exception:
    pass

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib
import cairo

GLib.set_prgname("wellbeing-dashboard")
GLib.set_application_name("Digital Wellbeing & Screen Care")

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "wellbeing"
STATE_FILE = STATE_DIR / "state.json"
SOCK_FILE = STATE_DIR / "daemon.sock"

DEFAULT_WORK_MIN = 45
DEFAULT_BREAK_MIN = 15
DEFAULT_GOAL_HOURS = 6

def send_client_command(cmd_dict):
    if not SOCK_FILE.exists():
        return None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.4)
        s.connect(str(SOCK_FILE))
        s.sendall(json.dumps(cmd_dict).encode("utf-8") + b"\n")
        data = s.recv(16384)
        s.close()
        if data:
            return json.loads(data.decode("utf-8"))
    except Exception:
        pass
    return None

def load_saved_state():
    if STATE_FILE.exists():
        try:
            with open(STATE_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return {}

def format_sot(sec):
    h = sec // 3600
    m = (sec % 3600) // 60
    if h > 0:
        return f"{h}h {m:02d}m"
    return f"{m}m"

def format_timer(sec):
    m = sec // 60
    s = sec % 60
    return f"{m:02d}:{s:02d}"

