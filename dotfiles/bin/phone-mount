#!/usr/bin/env bash
# ==============================================================================
# 📱 Arch Sway Workstation - Wireless Phone Storage Mount (Native FUSE)
# Mounts Android FTP/SFTP to ~/Phone via rclone VFS cache engine.
# - Full POSIX random-access seeking (MPV video streaming)
# - Native photo & video thumbnails
# - Permanent friendly bookmark name "📱 Phone Storage"
# - Zero login popups (100% silent, automatic anonymous auth)
# - Auto-cleans stale/zombie FUSE mounts before reconnecting
# ==============================================================================

MOUNT_DIR="$HOME/Phone"
CONFIG_FILE="$HOME/.config/phone-mount.conf"
BOOKMARKS_FILE="$HOME/.config/gtk-3.0/bookmarks"
DEFAULT_URI="ftp://192.168.31.157:2121"

if [[ -f "$CONFIG_FILE" ]]; then
    SAVED_URI=$(cat "$CONFIG_FILE" 2>/dev/null)
    [[ -n "$SAVED_URI" ]] && DEFAULT_URI="$SAVED_URI"
fi

do_unmount() {
    systemctl --user stop phone-mount 2>/dev/null || true
    systemctl --user reset-failed phone-mount 2>/dev/null || true
    fusermount -u -z "$MOUNT_DIR" 2>/dev/null || true
    pkill -9 -f "rclone mount.*Phone" 2>/dev/null || true
    notify-send -a "Phone Storage" -i phone "Phone Storage Unmounted" "Disconnected from Phone."
}

if [[ "$1" == "-u" || "$1" == "--unmount" ]]; then
    do_unmount
    exit 0
fi

# If already mounted and healthy, just open and focus Thunar
if mountpoint -q "$MOUNT_DIR" 2>/dev/null && ls "$MOUNT_DIR" >/dev/null 2>&1; then
    notify-send -a "Phone Storage" -i phone "Phone Storage Active" "Opening $MOUNT_DIR"
    thunar "$MOUNT_DIR" &
    sleep 0.3
    swaymsg '[app_id="thunar"] focus' 2>/dev/null || true
    exit 0
fi

# Determine URI (Zenity dialog if GUI, CLI if argument passed)
if [[ -n "$1" ]]; then
    RAW_URI="$1"
elif [ -n "$WAYLAND_DISPLAY" ] && command -v zenity >/dev/null 2>&1; then
    RAW_URI=$(zenity --entry \
        --title="📱 Wireless Phone Storage" \
        --text="1. Tap 'Start Server' on your phone\n2. Confirm phone address:" \
        --entry-text="$DEFAULT_URI" 2>/dev/null)
else
    read -rp "Enter Phone Server URI [$DEFAULT_URI]: " RAW_URI
    RAW_URI="${RAW_URI:-$DEFAULT_URI}"
fi

[[ -z "$RAW_URI" ]] && exit 0

# Parse Host & Port using Python
PARSED=$(python3 -c "
import urllib.parse, sys
uri = sys.argv[1].strip()
if '://' not in uri:
    uri = 'ftp://' + uri
u = urllib.parse.urlsplit(uri)
scheme = u.scheme or 'ftp'
port = u.port or (2222 if scheme == 'sftp' else 2121)
hostname = u.hostname or '127.0.0.1'
full_uri = f'{scheme}://{hostname}:{port}/'
print(f'{hostname} {port} {full_uri}')
" "$RAW_URI" 2>/dev/null)

read -r HOST PORT NORMALIZED_URI <<< "$PARSED"

if [[ -z "$HOST" || -z "$PORT" || -z "$NORMALIZED_URI" ]]; then
    notify-send -u critical -a "Phone Storage" -i dialog-error "Invalid Address" "Could not parse '$RAW_URI'."
    exit 1
fi

echo "$NORMALIZED_URI" > "$CONFIG_FILE"

# Fast preflight socket check (1.5s timeout)
IS_REACHABLE=$(python3 -c "
import socket, sys
try:
    s = socket.socket()
    s.settimeout(1.5)
    s.connect(('$HOST', int('$PORT')))
    s.close()
    print('OK')
except Exception:
    print('FAIL')
" 2>/dev/null)

if [[ "$IS_REACHABLE" != "OK" ]]; then
    notify-send -u critical -a "Phone Storage" -i network-error \
        "Phone Server Unreachable" \
        "Could not connect to $HOST:$PORT.\n\n✓ Make sure your phone and laptop are on the SAME Wi-Fi.\n✓ Make sure Wi-Fi FTP server is running on your phone."
    exit 1
fi

notify-send -a "Phone Storage" -i phone "Connecting to Phone..." "$HOST:$PORT"

# Clean any existing or stale/zombie FUSE mount cleanly
systemctl --user stop phone-mount 2>/dev/null || true
systemctl --user reset-failed phone-mount 2>/dev/null || true
fusermount -u -z "$MOUNT_DIR" 2>/dev/null || true
pkill -9 -f "rclone mount.*Phone" 2>/dev/null || true
sleep 0.2
mkdir -p "$MOUNT_DIR"

# Launch rclone mount as a managed user service with high-speed VFS caching and resilient connection limits
# NOTE: --buffer-size MUST be 0 to disable AsyncReader and prevent deadlock/freeze with --vfs-cache-mode full
systemd-run --user --unit=phone-mount --collect \
    rclone mount \
        ":ftp,host=${HOST},port=${PORT},user=anonymous,pass=_5VuALJ9M8jthLASrPcpJg:" \
        "$MOUNT_DIR" \
        --ftp-concurrency 2 \
        --checkers 1 \
        --transfers 1 \
        --vfs-cache-mode full \
        --vfs-cache-max-age 2h \
        --vfs-cache-max-size 10G \
        --vfs-read-chunk-size 16M \
        --vfs-read-chunk-size-limit off \
        --buffer-size 0 \
        --no-modtime \
        --no-checksum \
        --dir-cache-time 15m \
        --attr-timeout 10m \
        --timeout 45s \
        --contimeout 15s \
        --retries 3 \
        --low-level-retries 10 \
        --allow-non-empty \
        --log-file "$HOME/.config/phone-mount.log" \
        --log-level NOTICE \
        >/dev/null 2>&1

# Wait up to 3 seconds for mount to become ready and healthy
MOUNTED=false
for _ in {1..15}; do
    if mountpoint -q "$MOUNT_DIR" 2>/dev/null && ls "$MOUNT_DIR" >/dev/null 2>&1; then
        MOUNTED=true
        break
    fi
    sleep 0.2
done

if [[ "$MOUNTED" != "true" ]]; then
    fusermount -u -z "$MOUNT_DIR" 2>/dev/null || true
    notify-send -u critical -a "Phone Storage" -i dialog-error "Mount Failed" "Could not mount phone storage to $MOUNT_DIR."
    exit 1
fi

# Ensure friendly bookmark in GTK bookmarks file
mkdir -p "$(dirname "$BOOKMARKS_FILE")"
touch "$BOOKMARKS_FILE"
if ! grep -q "file://$MOUNT_DIR" "$BOOKMARKS_FILE" 2>/dev/null; then
    echo "file://$MOUNT_DIR 📱 Phone Storage" >> "$BOOKMARKS_FILE"
fi

notify-send -a "Phone Storage" -i phone "Phone Connected!" "Mounted at ~/Phone with video streaming & thumbnails."

# Auto-disconnect watchdog: continuously checks socket and automatically unmounts if FTP stops
(
    while mountpoint -q "$MOUNT_DIR" 2>/dev/null; do
        sleep 4
        REACHABLE=$(python3 -c "
import socket
try:
    s = socket.socket()
    s.settimeout(1.5)
    s.connect(('$HOST', int('$PORT')))
    s.close()
    print('OK')
except Exception:
    print('FAIL')
" 2>/dev/null)
        if [[ "$REACHABLE" != "OK" ]]; then
            fusermount -u -z "$MOUNT_DIR" 2>/dev/null || true
            systemctl --user stop phone-mount 2>/dev/null || true
            notify-send -a "Phone Storage" -i phone "Phone Disconnected" "Phone server stopped. Cleanly unmounted ~/Phone."
            break
        fi
    done
) >/dev/null 2>&1 &

# Open Thunar and bring to focus
thunar "$MOUNT_DIR" &
sleep 0.3
swaymsg '[app_id="thunar"] focus' 2>/dev/null || true
exit 0
