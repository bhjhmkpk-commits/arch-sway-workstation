#!/usr/bin/env bash
# ==============================================================================
# 🚀 Arch Sway Workstation - Interactive Utility Chart & Guide ($mod+k)
# Displays tools in an organized chart: What we have | What it's for | How to use
# Selecting any item executes it directly!
# ==============================================================================

CONF="$HOME/.config/wofi/cheatsheet.conf"
STYLE="$HOME/.config/wofi/cheatsheet.css"

ENTRIES=(
  "🎓 Xournal++     │ Annotate lecture PDFs, handwriting & sign forms       │ Hotkey: \$mod+p  •  CLI: xournalpp|xournalpp"
  "📑 PDF Arranger  │ Visual drag & drop PDF page split, merge, rotate, crop │ Hotkey: \$mod+Shift+p  •  CLI: pdfarranger|pdfarranger"
  "📷 Screen OCR    │ Select any screen area to extract and copy text        │ Hotkey: \$mod+Shift+o  •  Alt+Print|~/.local/bin/ocr-grab"
  "📋 Universal Copy│ Instant copy across terminal & GUI apps                │ Hotkey: \$mod+c  •  Ctrl+Shift+C in terminal|~/.local/bin/universal-copy"
  "📋 Universal Paste│ Instant paste across terminal & GUI apps               │ Hotkey: \$mod+v  •  Ctrl+Shift+V in terminal|~/.local/bin/universal-paste"
  "📋 Push to Phone │ Send laptop clipboard (text/photo) to phone bridge     │ Hotkey: \$mod+Ctrl+c  •  clip-push|~/.local/bin/clip-push"
  "🧮 Qalc (calc)   │ Symbolic math, physics units, calculus & currencies    │ Command: calc \"50 USD in INR\" • Hotkey: \$mod+=|foot -e qalc"
  "🔢 Galculator    │ Lightweight GTK scientific desktop calculator          │ Hotkey: \$mod+=  •  CLI: galculator|galculator"
  "📱 Scrcpy        │ 60fps Android screen mirror & mouse/keyboard control   │ Hotkey: \$mod+a  (over USB or Wi-Fi)|scrcpy"
  "📱 Phone Storage │ Wireless phone storage in Thunar (Samsung style)       │ Hotkey: \$mod+Ctrl+m  •  phone-mount|~/.local/bin/phone-mount"
  "📱 Phone Clip    │ Wireless Phone <> PC 2-way clipboard bridge (QR code)  │ Hotkey: \$mod+Ctrl+p  •  phone-clip|foot --app-id=phone-clip -e ~/.local/bin/phone-clip"
  "📱 LocalSend     │ Open-source AirDrop: fast wireless file & text send    │ Hotkey: \$mod+Alt+l  •  localsend|localsend"
  "📱 Debloater     │ Safely remove or disable vendor & carrier bloatware    │ Hotkey: \$mod+Alt+a  •  uad-ng|uad-ng"
  "💾 Disks (GUI)   │ Format USB (FAT32/exFAT/NTFS) & burn ISO to USB drive  │ Hotkey: \$mod+u  •  gnome-disks|gnome-disks"
  "💾 Ventoy        │ Multi-boot USB engine: drag-and-drop multiple ISOs     │ Hotkey: \$mod+Shift+u  •  ventoygui|ventoygui"
  "💾 GDU Storage   │ Interactive, arrow-key disk space usage explorer       │ Hotkey: \$mod+Ctrl+d  •  gdu ~|foot --app-id=gdu -e gdu ~"
  "🎨 Pinta         │ Fast image editor for cropping, retouch & layers       │ Hotkey: \$mod+i  •  CLI: pinta|pinta"
  "📝 Mousepad      │ Fast GUI tabbed text editor with syntax highlighting   │ Hotkey: \$mod+m  •  CLI: mousepad|mousepad"
  "📦 LazyGit       │ Visual TUI for Git: stage lines, branches, diffs       │ Hotkey: \$mod+g  •  CLI: lg|foot --app-id=lazygit -e lazygit"
  "🗂️ Zoxide (z)    │ Smarter cd: learns habits and jumps directly to dirs   │ Command: z <folder> (e.g. z jam)|notify-send -a 'Zoxide' 'Smart Directory Jump' 'Use \"z <name>\" in terminal to jump directly to any folder.'"
  "💡 Tealdeer      │ Real-world practical cheatsheets for any Linux command │ Command: tldr <cmd> (e.g. tldr tar)|foot -e bash -c 'echo \"Usage: tldr <command> (e.g., tldr tar, tldr adb)\"; exec bash'"
  "🐍 UV Runner     │ Modern isolated runner for Python & AI scripts         │ Command: uv run <script.py>|foot -e bash -c 'echo \"Usage: uv run <script.py>\"; exec bash'"
  "🔍 ShellCheck    │ Static analysis bug & syntax linter for bash scripts   │ Command: shellcheck <script>|foot -e bash -c 'echo \"Usage: shellcheck <script.sh>\"; exec bash'"
  "🖥️ Btop Monitor  │ CPU, GPU, memory, processes & network monitor         │ Hotkey: \$mod+Escape  •  CLI: btop|foot --app-id=btop -e btop"
  "📋 Cliphist      │ Searchable clipboard history manager menu              │ Hotkey: \$mod+Shift+v|~/.local/bin/cliphist-menu"
  "📷 Satty Screen  │ Full screen or cropped screenshot with annotation     │ Hotkey: Print / Shift+Print|~/.local/bin/screenshot area"
  "🌙 Night Light   │ Eye-care blue light reduction filter (wlsunset)        │ Hotkey: \$mod+n (toggle) • \$mod+Shift+n|~/.local/bin/nightlight toggle"
  "🧘 Wellbeing     │ 20-20-20 eye strain reminder & screen time limiter     │ Hotkey: \$mod+Alt+e (menu)|~/.local/bin/sway-wellbeing menu"
  "📁 Thunar        │ Graphical file manager with MTP Android phone browsing │ Hotkey: \$mod+Shift+f|thunar"
  "📁 Yazi          │ Blazing-fast terminal file manager with image previews │ Hotkey: \$mod+Alt+f|foot --app-id=yazi -e yazi"
  "🌐 Chromium      │ Fast native Wayland web browser                        │ Hotkey: \$mod+b|chromium"
  "🔒 Swaylock      │ Secure Wayland session lock screen                     │ Hotkey: \$mod+Backspace / \$mod+Ctrl+l|swaylock"
)

LABELS=""
for entry in "${ENTRIES[@]}"; do
    label="${entry%%|*}"
    LABELS+="${label}"$'\n'
done

SELECTED=$(echo -n "$LABELS" | wofi --conf "$CONF" --style "$STYLE" --dmenu --prompt "⚡ Utility Chart & Guide (\$mod+k)")

if [[ -z "$SELECTED" ]]; then
    exit 0
fi

for entry in "${ENTRIES[@]}"; do
    label="${entry%%|*}"
    action="${entry#*|}"
    if [[ "$SELECTED" == "$label" ]]; then
        eval "$action" &
        exit 0
    fi
done
