#!/usr/bin/env bash
# ==============================================================================
# 📋 Arch Sway Workstation - Universal Paste ($mod+v)
# Sends Ctrl+Shift+V in terminal (foot/tmux) and Ctrl+V in GUI apps
# ==============================================================================

APP=$(swaymsg -t get_tree 2>/dev/null | jq -r '.. | select(.focused? == true) | .app_id // .window_properties.class' 2>/dev/null)

sleep 0.05

if [[ "$APP" == "foot" || "$APP" == "tmux" ]]; then
    wtype -m logo -m win -M ctrl -M shift -k v -m shift -m ctrl 2>/dev/null || wtype -m logo -m win -M ctrl -k v -m ctrl 2>/dev/null
else
    wtype -m logo -m win -M ctrl -k v -m ctrl 2>/dev/null
fi
