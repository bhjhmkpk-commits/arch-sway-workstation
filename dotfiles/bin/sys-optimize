#!/usr/bin/env bash
# ==============================================================================
# 🚀 Arch Sway Workstation - System Optimization & Essentials Script
# Configures SSD trim, pacman maintenance, DDC/CI brightness & removes daemon redundancy
# ==============================================================================

set -e

if [ "$EUID" -ne 0 ]; then
    echo "Please run with sudo: sudo sys-optimize"
    exit 1
fi

CURRENT_USER="${SUDO_USER:-$USER}"

echo "==> 1. Installing essential utility packages..."
pacman -S --needed --noconfirm ddcutil pacman-contrib ffmpegthumbnailer xdg-user-dirs github-cli

echo "==> 2. Setting up DDC/CI hardware monitor brightness (i2c-dev)..."
echo "i2c-dev" > /etc/modules-load.d/i2c-dev.conf
modprobe i2c-dev || true
usermod -aG i2c "$CURRENT_USER" || true

echo "==> 3. Enabling weekly SSD Trim & automatic Pacman cache cleaner timers..."
systemctl enable --now fstrim.timer
systemctl enable --now paccache.timer

echo "==> 4. Removing duplicate network daemon (systemd-networkd)..."
systemctl disable --now systemd-networkd.socket systemd-networkd.service 2>/dev/null || true

echo "==> 5. Capping systemd journal size to 50M to prevent disk creep..."
mkdir -p /etc/systemd/journald.conf.d
cat << 'EOF' > /etc/systemd/journald.conf.d/00-journal-size.conf
[Journal]
SystemMaxUse=50M
RuntimeMaxUse=20M
EOF
systemctl restart systemd-journald

echo "==> 6. Cleaning pacman package cache (retaining last 2 versions)..."
paccache -rk2 || true

echo "==> 7. Configuring high-efficiency ZRAM kernel tuning (swappiness=180)..."
cat << 'EOF' > /etc/sysctl.d/99-zram.conf
# Arch Sway Workstation - ZRAM Kernel Tuning
vm.swappiness = 180
vm.watermark_boost_factor = 0
vm.watermark_scale_factor = 125
vm.page-cluster = 0
EOF
sysctl -p /etc/sysctl.d/99-zram.conf || true

echo "==> 8. Setting CPU power profile to Maximum Performance (governor + EPP)..."
cat << 'EOF' > /etc/tmpfiles.d/cpu-performance.conf
w /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor - - - - performance
w /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference - - - - performance
w /sys/devices/system/cpu/cpu*/power/energy_perf_bias - - - - performance
EOF
for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > "$g" 2>/dev/null || true; done
for e in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do echo performance > "$e" 2>/dev/null || true; done
for b in /sys/devices/system/cpu/cpu*/power/energy_perf_bias; do echo performance > "$b" 2>/dev/null || true; done

echo "==> 9. Optimizing shutdown timeouts (10s) and disabling battery daemons on desktop..."
mkdir -p /etc/systemd/system.conf.d /etc/systemd/user.conf.d
cat << 'EOF' > /etc/systemd/system.conf.d/timeout.conf
[Manager]
DefaultTimeoutStopSec=10s
DefaultTimeoutAbortSec=10s
EOF
cat << 'EOF' > /etc/systemd/user.conf.d/timeout.conf
[Manager]
DefaultTimeoutStopSec=10s
DefaultTimeoutAbortSec=10s
EOF
systemctl daemon-reexec 2>/dev/null || true
systemctl mask upower.service 2>/dev/null || true

echo -e "\n\033[0;32m✓ System optimization complete! Resource usage minimized and essentials in place.\033[0m"
